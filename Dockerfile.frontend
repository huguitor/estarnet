
# Build stage for panozosistemas.com.ar
FROM node:22-alpine AS panozosistemas-builder
WORKDIR /app/frontend

COPY frontend/package*.json ./
RUN npm install

COPY frontend/ ./
RUN npm run build

# Build stage for nag.com.ar
FROM node:22-alpine AS nag-builder
WORKDIR /app/nag-astro

COPY nginx/sites/nag-astro/package*.json ./
RUN npm ci

COPY nginx/sites/nag-astro/ ./
RUN npm run build

# Production stage
FROM nginx:1.25-alpine
COPY nginx/default.conf /etc/nginx/conf.d/default.conf
COPY --from=panozosistemas-builder /app/frontend/dist /usr/share/nginx/panozosistemas
COPY --from=nag-builder /app/nag-astro/dist /usr/share/nginx/nag

EXPOSE 80
CMD ["nginx", "-g", "daemon off;"]
